# Copy this file to .env and fill in your values.
# Vercel deploy: yehi variables Vercel dashboard me set karo
# (Project -> Settings -> Environment Variables), phir redeploy.

# Supabase (REQUIRED) — Dashboard -> Project Settings -> API se milega
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ERP proxy URL (optional) — khali chhodo to default:
# <VITE_SUPABASE_URL>/functions/v1/fms-proxy
# VITE_FMS_PROXY_URL=

# WhatsApp country code (optional, default 91 = India)
# VITE_WA_COUNTRY_CODE=91
